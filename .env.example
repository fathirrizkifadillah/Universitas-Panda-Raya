# ==========================================
# Zero Trust Academic Records ("NILAI")
# Environment Configuration Template
# ==========================================

# Service Ports
PORT=3000
GATEWAY_PORT=3000
SERVICE_NILAI_PORT=3001
SERVICE_TRANSKRIP_PORT=3002
FRONTEND_PORT=5173

# Service URLs
GATEWAY_URL=http://localhost:3000
SERVICE_NILAI_URL=http://localhost:3001
SERVICE_TRANSKRIP_URL=http://localhost:3002
FRONTEND_URL=http://localhost:5173

# Shared Secret (Gateway to Services)
# Generated server-side, injected by Gateway PEP, verified by Services
GATEWAY_SECRET=sec_zt_gateway_prod_9f482a17cb6e310d54a2

# JWT Security
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=1d
SERVICE_TOKEN_TTL=5m
JWT_ISSUER=zero-trust-gateway
JWT_AUDIENCE=zero-trust-system

# Access Window (Asia/Jakarta, 07:00 to 21:00)
ACCESS_WINDOW_START=07:00
ACCESS_WINDOW_END=21:00
ACCESS_TIMEZONE=Asia/Jakarta

# Database Configuration (PostgreSQL 17 Local)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password_here
PGDATABASE=zero_trust_db

# Service Client Credentials (used by Service Nilai to request service JWT)
SERVICE_CLIENT_ID=grades-service-client
SERVICE_CLIENT_SECRET=grades_client_super_secret_key_8820
